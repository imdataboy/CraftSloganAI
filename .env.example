# Placeholder values only. Never commit your real .env.
DATABASE_URL=postgresql+psycopg2://replace_user:replace_password@127.0.0.1:5432/slogancraft_db
POSTGRES_USER=replace_user
POSTGRES_PASSWORD=replace_password
POSTGRES_DB=slogancraft_db
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key
FRONTEND_ORIGINS=http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://127.0.0.1:5000
GENERATED_IMAGE_DIR=generated_images
# Required only when using the corresponding integration.
# CrewAI/LiteLLM identifier: groq/<model-available-to-your-account>
MODEL=replace_with_a_supported_groq_model_identifier
GROQ_API_KEY=replace_with_a_rotated_key
HUGGINGFACE_API_KEY=replace_with_a_rotated_key
# Choose an owner/model served by the HF Inference text-to-image provider.
HUGGINGFACE_MODEL=replace_owner/replace_model
GOOGLE_CLIENT_ID=replace_with_your_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_a_rotated_client_secret
LINKEDIN_CLIENT_ID=replace_with_your_oauth_client_id
LINKEDIN_CLIENT_SECRET=replace_with_a_rotated_client_secret
GEMINI_API_KEY=replace_with_a_rotated_key
GEMINI_MODEL=replace_with_a_supported_gemini_model
